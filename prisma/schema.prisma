// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ENUMS

enum Role {
  CUSTOMER
  ORGANIZER
}

enum OrganizerType {
  INDIVIDUAL // perorangan
  COMPANY // badan usaha (PT, CV, yayasan, dll.)
}

enum TransactionStatus {
  WAITING_PAYMENT
  WAITING_CONFIRMATION
  DONE
  REJECTED
  EXPIRED
  CANCELED
}

enum EventCategory {
  MUSIC
  WORKSHOP
  COMEDY
  SPORTS
  ARTS
  GAMES
}

// FEATURE 2: AUTH, REFERRAL, PRIZES

model Customer {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String    @unique @db.VarChar(255)
  username          String    @unique @db.VarChar(50)
  password          String    @db.VarChar(255)
  name              String    @db.VarChar(100)
  nik               String?   @unique @db.VarChar(16)
  role              Role      @default(CUSTOMER)
  phoneNumber       String?   @db.VarChar(20)
  profilePictureUrl String?   @db.VarChar(500)
  referralCode      String    @unique @db.VarChar(12)
  referredById      String?   @db.Uuid
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deletedAt         DateTime? @db.Timestamptz(6)

  // --- relasi ---
  referredBy          Customer?            @relation("CustomerReferral", fields: [referredById], references: [id], onDelete: SetNull)
  referrals           Customer[]           @relation("CustomerReferral")
  passwordResetTokens PasswordResetToken[]
  points              Point[]
  coupons             Coupon[]
  transactions        Transaction[]
  reviews             Review[]

  @@index([referredById])
  @@map("customers")
}

model Organizer {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String    @unique @db.VarChar(150)
  username          String    @unique @db.VarChar(100)
  password          String    @db.VarChar(255)
  role              Role      @default(ORGANIZER)
  profilePictureUrl String?   @db.VarChar(500) // logo organizer

  // --- identitas organizer ---
  organizerName String        @db.VarChar(150) // nama brand yang tampil di event
  organizerType OrganizerType
  legalName     String        @db.VarChar(200) // nama sesuai NPWP / akta (perorangan: nama sesuai KTP)
  organizerBio  String?       @db.Text
  websiteUrl    String?       @db.VarChar(255)
  instagramUrl  String?       @db.VarChar(255)

  // --- legalitas ---
  npwp         String  @unique @db.VarChar(16) // 16 digit, tanpa titik/strip
  nib          String? @unique @db.VarChar(13) // Nomor Induk Berusaha, wajib untuk COMPANY

  // --- penanggung jawab (PIC) ---
  picName        String @db.VarChar(100)
  picNik         String @db.VarChar(16) // NIK KTP, 16 digit
  picPhoneNumber String @db.VarChar(20)

  // --- alamat kantor ---
  officeAddress String @db.VarChar(500)
  city          String @db.VarChar(50)
  province      String @db.VarChar(50)
  postalCode    String @db.VarChar(5)

  // --- rekening pencairan dana ---
  bankName          String @db.VarChar(100)
  bankAccountNumber String @db.VarChar(30)
  bankAccountHolder String @db.VarChar(200) // harus sama dengan legalName

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  // --- relasi ---
  events              Event[]
  passwordResetTokens PasswordResetToken[]

  @@map("organizers")
}

// Dipakai customer maupun organizer: isi salah satu dari customerId / organizerId
model PasswordResetToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId  String?   @db.Uuid
  organizerId String?   @db.Uuid
  tokenHash   String    @unique @db.VarChar(255)
  expiresAt   DateTime  @db.Timestamptz(6)
  usedAt      DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  // --- relasi ---
  customer  Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organizer Organizer? @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([organizerId])
  @@map("password_reset_tokens")
}

model Point {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String   @db.Uuid
  amount     Int
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  // --- relasi ---
  customer Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  usages   PointUsage[]

  @@index([customerId, expiresAt])
  @@map("points")
}

model Coupon {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId     String    @db.Uuid
  code           String    @unique @db.VarChar(30)
  discountAmount Int
  expiresAt      DateTime  @db.Timestamptz(6)
  usedAt         DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  // --- relasi ---
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([customerId, expiresAt])
  @@map("coupons")
}

// FEATURE 1: EVENT, TRANSACTION, REVIEW

model Event {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizerId    String        @db.Uuid
  name           String        @db.VarChar(200)
  description    String
  category       EventCategory
  city           String        @db.VarChar(100)
  venue          String        @db.VarChar(200)
  imageUrl       String?       @db.VarChar(500)
  price          Int           @default(0)
  startDate      DateTime      @db.Timestamptz(6)
  endDate        DateTime      @db.Timestamptz(6)
  totalSeats     Int
  availableSeats Int
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @updatedAt @db.Timestamptz(6)

  // --- relasi ---
  organizer    Organizer     @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  ticketTypes  TicketType[]
  vouchers     Voucher[]
  transactions Transaction[]
  reviews      Review[]

  @@index([organizerId])
  @@index([category])
  @@index([city])
  @@index([startDate])
  @@map("events")
}

model TicketType {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String @db.Uuid
  name      String @db.VarChar(100)
  price     Int
  quota     Int
  available Int
  endSale   DateTime? @db.Timestamptz(6)

  // --- relasi ---
  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([eventId, name])
  @@map("ticket_types")
}

model Voucher {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId        String   @db.Uuid
  code           String   @db.VarChar(30)
  discountAmount Int
  quota          Int?
  usedCount      Int      @default(0)
  startDate      DateTime @db.Timestamptz(6)
  endDate        DateTime @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  // --- relasi ---
  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([eventId, code])
  @@map("vouchers")
}

model Transaction {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId             String            @db.Uuid
  eventId                String            @db.Uuid
  ticketTypeId           String?           @db.Uuid
  quantity               Int
  unitPrice              Int
  subtotal               Int
  voucherId              String?           @db.Uuid
  voucherDiscount        Int               @default(0)
  couponId               String?           @db.Uuid
  couponDiscount         Int               @default(0)
  pointsUsed             Int               @default(0)
  totalPrice             Int
  status                 TransactionStatus @default(WAITING_PAYMENT)
  paymentProofUrl        String?           @db.VarChar(500)
  paymentProofUploadedAt DateTime?         @db.Timestamptz(6)
  paymentExpiresAt       DateTime?         @db.Timestamptz(6)
  confirmDeadlineAt      DateTime?         @db.Timestamptz(6)
  decidedAt              DateTime?         @db.Timestamptz(6)
  createdAt              DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime          @default(now()) @updatedAt @db.Timestamptz(6)

  // --- relasi ---
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  ticketType  TicketType?  @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  voucher     Voucher?     @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  coupon      Coupon?      @relation(fields: [couponId], references: [id], onDelete: Restrict)
  pointUsages PointUsage[]

  @@index([customerId])
  @@index([eventId, status])
  @@index([status, paymentExpiresAt], map: "idx_tx_cron_expire")
  @@index([status, confirmDeadlineAt], map: "idx_tx_cron_cancel")
  @@map("transactions")
}

model PointUsage {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId String    @db.Uuid
  pointId       String    @db.Uuid
  amount        Int
  restoredAt    DateTime? @db.Timestamptz(6)

  // --- relasi ---
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  point       Point       @relation(fields: [pointId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([pointId])
  @@map("point_usages")
}

model Review {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String   @db.Uuid
  eventId    String   @db.Uuid
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  // --- relasi ---
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([customerId, eventId])
  @@index([eventId])
  @@map("reviews")
}
